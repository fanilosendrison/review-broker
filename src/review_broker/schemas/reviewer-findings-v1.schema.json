{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fanilosendrison/review-broker/schemas/reviewer-findings-v1.schema.json",
  "title": "ReviewerFindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "subject_id", "packet_id", "verdict", "sources_examined", "findings", "remaining_uncertainties"],
  "properties": {
    "schema_version": {"const": 1},
    "request_id": {"type": "string", "pattern": "^request:sha256:[0-9a-f]{64}$"},
    "subject_id": {"type": "string", "pattern": "^subject:sha256:[0-9a-f]{64}$"},
    "packet_id": {"type": "string", "pattern": "^packet:sha256:[0-9a-f]{64}$"},
    "verdict": {"enum": ["GO", "NO_GO", "UNDETERMINED"]},
    "sources_examined": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^S[0-9]{3}$"}},
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "claim", "consequence", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^F[0-9]{3}$"},
          "category": {"enum": ["authority-gap", "contradiction", "unsupported-claim", "uncertainty-gap", "dependency-gap", "evidence-gap", "security", "other"]},
          "claim": {"type": "string", "minLength": 5, "maxLength": 5000},
          "consequence": {"type": "string", "minLength": 5, "maxLength": 5000},
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_id", "line", "quote"],
              "properties": {
                "source_id": {"type": "string", "pattern": "^S[0-9]{3}$"},
                "line": {"type": "integer", "minimum": 1},
                "quote": {"type": "string", "minLength": 1, "maxLength": 1000}
              }
            }
          }
        }
      }
    },
    "remaining_uncertainties": {"type": "array", "maxItems": 100, "items": {"type": "string", "minLength": 1, "maxLength": 5000}}
  }
}
