{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fanilosendrison/review-broker/schemas/jch-storage-authority-basis-v1.schema.json",
  "title": "Storage authority hash-preimage v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "repository_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "ref": {
      "type": "string",
      "const": "refs/heads/dev"
    },
    "workflows": {
      "$ref": "https://github.com/fanilosendrison/review-broker/schemas/jch-storage-authority-basis-v1.schema.json#/$defs/workflows"
    },
    "actors": {
      "$ref": "https://github.com/fanilosendrison/review-broker/schemas/jch-storage-authority-basis-v1.schema.json#/$defs/actors"
    },
    "recovery_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^request:sha256:[0-9a-f]{64}$"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^attempt:sha256:[0-9a-f]{64}$"
        },
        "arm_commit_sha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "terminal_locator_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^artifact:sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "request_id",
        "attempt_id",
        "arm_commit_sha",
        "terminal_locator_id"
      ]
    }
  },
  "required": [
    "repository",
    "repository_id",
    "owner_id",
    "ref",
    "workflows",
    "actors",
    "recovery_scope"
  ],
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workflow_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "workflow_sha": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[0-9a-f]{40}$"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[.]github/workflows/[A-Za-z0-9-]+[.]yml$"
        },
        "job_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "upload_step": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      },
      "required": [
        "workflow_ref",
        "workflow_sha",
        "path",
        "job_name",
        "upload_step",
        "events"
      ]
    },
    "workflows": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "original": {
          "$ref": "https://github.com/fanilosendrison/review-broker/schemas/jch-storage-authority-basis-v1.schema.json#/$defs/role"
        },
        "recovery": {
          "$ref": "https://github.com/fanilosendrison/review-broker/schemas/jch-storage-authority-basis-v1.schema.json#/$defs/role"
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9007199254740991
      }
    }
  }
}
