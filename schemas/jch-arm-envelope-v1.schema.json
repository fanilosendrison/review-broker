{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fanilosendrison/review-broker/schemas/jch-arm-envelope-v1.schema.json",
  "title": "Proposed j-ch-v1 execution envelope; NOT legacy ARM v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "protocol_id": {
      "type": "string",
      "const": "j-ch-v1"
    },
    "authorization_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "broker_repository": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "broker_repository_owner_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20,
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "ref": {
      "type": "string",
      "const": "refs/heads/dev"
    },
    "arm_commit_sha": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "binding": {
      "$ref": "https://github.com/fanilosendrison/review-broker/schemas/jch-journal-v2.schema.json#/$defs/binding"
    },
    "broker_metadata_sha256": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "capacity_receipt": {
      "$ref": "https://github.com/fanilosendrison/review-broker/schemas/jch-journal-v2.schema.json#/properties/input_capacity"
    },
    "reviewer_policy": {
      "$ref": "https://github.com/fanilosendrison/review-broker/schemas/jch-deployment-policy-v1.schema.json#/$defs/reviewer_policy"
    }
  },
  "required": [
    "schema_version",
    "protocol_id",
    "authorization_id",
    "broker_repository",
    "broker_repository_owner_id",
    "ref",
    "arm_commit_sha",
    "binding",
    "broker_metadata_sha256",
    "capacity_receipt",
    "reviewer_policy"
  ]
}
