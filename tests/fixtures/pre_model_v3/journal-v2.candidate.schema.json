{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "attempt_id",
    "state",
    "evidence_ids",
    "invocation_count",
    "evidence_locator_plan",
    "evidence_locator",
    "publication_intent",
    "publication_receipt",
    "admission",
    "packet_evidence_id",
    "pre_model_control",
    "history"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "request_id": {
      "type": "string",
      "pattern": "^request:sha256:[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt:sha256:[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "REQUESTED",
        "ADMITTED",
        "PREPARED",
        "ARMED",
        "STOPPED"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^artifact:sha256:[0-9a-f]{64}$"
      },
      "uniqueItems": true
    },
    "invocation_count": {
      "enum": [
        0,
        1
      ]
    },
    "evidence_locator_plan": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_locator": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "publication_intent": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "publication_receipt": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "admission": {
      "type": "object",
      "minProperties": 1
    },
    "packet_evidence_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^artifact:sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "pre_model_control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generation",
        "disposition",
        "reservation_id",
        "authorization_id",
        "worker",
        "failure_receipt_id"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "generation": {
          "type": "integer",
          "minimum": 0
        },
        "disposition": {
          "enum": [
            "UNRESERVED",
            "RESERVED",
            "BLOCKED",
            "REFUSED_PERMANENT"
          ]
        },
        "reservation_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^preparation-dispatch:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "authorization_id": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^request:sha256:[0-9a-f]{64}$"
                },
                {
                  "type": "string",
                  "pattern": "^pre-model-recovery:sha256:[0-9a-f]{64}$"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "worker": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "run_id",
                "run_attempt"
              ],
              "properties": {
                "run_id": {
                  "type": "integer",
                  "minimum": 1
                },
                "run_attempt": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "failure_receipt_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^artifact:sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "generation": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "reservation_id": {
                "type": "null"
              },
              "authorization_id": {
                "type": "null"
              },
              "worker": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "generation": {
                "minimum": 1
              }
            }
          },
          "then": {
            "properties": {
              "reservation_id": {
                "type": "string",
                "pattern": "^preparation-dispatch:sha256:[0-9a-f]{64}$"
              },
              "authorization_id": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^request:sha256:[0-9a-f]{64}$"
                  },
                  {
                    "type": "string",
                    "pattern": "^pre-model-recovery:sha256:[0-9a-f]{64}$"
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "UNRESERVED"
              }
            }
          },
          "then": {
            "properties": {
              "generation": {
                "const": 0
              },
              "worker": {
                "type": "null"
              },
              "failure_receipt_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "RESERVED"
              }
            }
          },
          "then": {
            "properties": {
              "failure_receipt_id": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "disposition": {
                "enum": [
                  "BLOCKED",
                  "REFUSED_PERMANENT"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "failure_receipt_id": {
                "type": "string",
                "pattern": "^artifact:sha256:[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "generation",
          "evidence_id",
          "receipt"
        ],
        "properties": {
          "kind": {
            "enum": [
              "CLAIMED",
              "DISPATCH_RESERVED",
              "WORKER_BOUND",
              "ADMITTED",
              "PREPARED",
              "ARMED",
              "PREMODEL_FAILED",
              "RECOVERY_AUTHORIZED",
              "STOPPED"
            ]
          },
          "generation": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^artifact:sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "receipt": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "PREPARED",
              "ARMED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "packet_evidence_id": {
            "type": "string",
            "pattern": "^artifact:sha256:[0-9a-f]{64}$"
          },
          "pre_model_control": {
            "properties": {
              "disposition": {
                "const": "RESERVED"
              },
              "worker": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "REQUESTED",
              "ADMITTED"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "invocation_count": {
            "const": 0
          },
          "packet_evidence_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "ARMED"
          }
        }
      },
      "then": {
        "properties": {
          "invocation_count": {
            "const": 1
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fanilosendrison/review-broker/tests/fixtures/pre_model_v3/journal-v2.candidate.schema.json",
  "title": "UNACCEPTED NONNORMATIVE experimental v3-only journal v2 pre-model slice"
}
