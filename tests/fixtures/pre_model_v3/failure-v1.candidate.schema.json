{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_type",
    "request_id",
    "attempt_id",
    "admission_evidence_id",
    "generation",
    "reservation_id",
    "workflow_run_id",
    "workflow_run_attempt",
    "classification",
    "reason_code",
    "reference_id",
    "observation_evidence_id",
    "observed_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence_type": {
      "const": "pre-model-preparation-failure"
    },
    "request_id": {
      "type": "string",
      "pattern": "^request:sha256:[0-9a-f]{64}$"
    },
    "attempt_id": {
      "type": "string",
      "pattern": "^attempt:sha256:[0-9a-f]{64}$"
    },
    "admission_evidence_id": {
      "type": "string",
      "pattern": "^artifact:sha256:[0-9a-f]{64}$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0
    },
    "reservation_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^preparation-dispatch:sha256:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "workflow_run_id": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "workflow_run_attempt": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "classification": {
      "enum": [
        "PERMANENT",
        "TRANSIENT",
        "UNKNOWN"
      ]
    },
    "reason_code": {
      "enum": [
        "UNSUPPORTED_KIND",
        "REPOSITORY_ID_MISMATCH",
        "OBJECT_ID_MISMATCH",
        "PERMISSION_DENIED_VERIFIED",
        "SOURCE_DIGEST_MISMATCH",
        "UNSUPPORTED_ATOMICITY",
        "SOURCE_REQUIRED_ABSENT",
        "SOURCE_TRANSFER_FAILURE",
        "GITHUB_API_TRANSIENT",
        "DISPATCH_OUTCOME_UNKNOWN",
        "API_OBSERVATION_UNKNOWN",
        "PRE_MODEL_CRASH_UNKNOWN"
      ]
    },
    "reference_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation_evidence_id": {
      "type": "string",
      "pattern": "^artifact:sha256:[0-9a-f]{64}$"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generation": {
            "const": 0
          }
        }
      },
      "then": {
        "properties": {
          "reservation_id": {
            "type": "null"
          },
          "workflow_run_id": {
            "type": "null"
          },
          "workflow_run_attempt": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "generation": {
            "minimum": 1
          }
        }
      },
      "then": {
        "properties": {
          "reservation_id": {
            "type": "string",
            "pattern": "^preparation-dispatch:sha256:[0-9a-f]{64}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "const": "PERMANENT"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "UNSUPPORTED_KIND",
              "REPOSITORY_ID_MISMATCH",
              "OBJECT_ID_MISMATCH",
              "PERMISSION_DENIED_VERIFIED",
              "SOURCE_DIGEST_MISMATCH",
              "UNSUPPORTED_ATOMICITY",
              "SOURCE_REQUIRED_ABSENT"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "const": "TRANSIENT"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "SOURCE_TRANSFER_FAILURE",
              "GITHUB_API_TRANSIENT"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "classification": {
            "const": "UNKNOWN"
          }
        }
      },
      "then": {
        "properties": {
          "reason_code": {
            "enum": [
              "DISPATCH_OUTCOME_UNKNOWN",
              "API_OBSERVATION_UNKNOWN",
              "PRE_MODEL_CRASH_UNKNOWN"
            ]
          }
        }
      }
    }
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fanilosendrison/review-broker/tests/fixtures/pre_model_v3/failure-v1.candidate.schema.json",
  "title": "UNACCEPTED NONNORMATIVE experimental candidate failure-v1.candidate.schema.json"
}
